    "scr", "bat", "cmd", "msi", "jar", "vbs", "ps1", "hta", "com", "pif", "wsf",
    "iso", "img", "docm", "xlsm", "dll", "sys", "lnk", "url", "scf", "reg", "inf", "jse", "vbe",
    "wsh", "ws", "wsc", "cpl", "ocx"
  ],
